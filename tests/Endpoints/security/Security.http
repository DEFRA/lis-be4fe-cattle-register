### Start a submission (no x-api-key)
GET {{host}}/submission/start?cph={{cph}}
x-cdp-request-id: {{$guid}}
Accept: application/json

> ../asserts/Should_be_401_unauthorized.js

### Start a submission (wrong x-api-key)
GET {{host}}/submission/start?cph={{cph}}
x-api-key: not-a-valid-key
x-cdp-request-id: {{$guid}}
Accept: application/json

> ../asserts/Should_be_401_unauthorized.js

### Start a submission (no x-cdp-request-id)
GET {{host}}/submission/start?cph={{cph}}
x-api-key: {{apiKey}}
Accept: application/json

> ../asserts/Should_be_400_missing_header.js
