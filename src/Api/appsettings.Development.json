{
  "ApiKeyAuthentication": {
    "Keys": []
  },
  "CattleApi": {
    "BaseUrl": "http://localhost:5019",
    "ApiKey": ""
  },
  "Mongo": {
    "DatabaseUri": "mongodb://127.0.0.1:27017",
    "DatabaseName": "lis-be4fe-cattle-register"
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] ({MachineName}/{SourceContext}) [{CorrelationId}] {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
